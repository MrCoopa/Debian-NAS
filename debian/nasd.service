[Unit]
Description=Debian NAS Management Daemon (ZFS, Samba, NFS & HDD Standby)
After=network.target zfs-mount.service smbd.service
Wants=zfs-mount.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/nasd -port 8080 -config /etc/nas/config.json
Restart=always
RestartSec=5s
# Appliance Service configuration (Storage Daemon needs write access to /etc for useradd, /var/lib/samba, /mnt)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
